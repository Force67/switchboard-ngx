# Backend/Frontend shared environment template
# Copy to .env in repo root. Backend reads SWITCHBOARD_* vars directly (no TOML needed).

# --- Backend config via environment (overrides TOML) ---
SWITCHBOARD__HTTP__ADDRESS=127.0.0.1
SWITCHBOARD__HTTP__PORT=7080
SWITCHBOARD__DATABASE__URL=sqlite://switchboard.db
SWITCHBOARD__DATABASE__MAX_CONNECTIONS=10
SWITCHBOARD__AUTH__SESSION_TTL_SECONDS=86400
SWITCHBOARD__AUTH__GITHUB__CLIENT_ID=
SWITCHBOARD__AUTH__GITHUB__CLIENT_SECRET=
SWITCHBOARD__ORCHESTRATOR__DEFAULT_MODEL=openrouter/meta-llama/llama-3.1-70b-instruct
SWITCHBOARD__ORCHESTRATOR__OPENROUTER__API_KEY=
SWITCHBOARD__ORCHESTRATOR__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
SWITCHBOARD__ORCHESTRATOR__OPENROUTER__REQUEST_TIMEOUT_SECONDS=30
# Optional extras
#SWITCHBOARD__ORCHESTRATOR__OPENROUTER__REFERER=https://your-app.example
#SWITCHBOARD__ORCHESTRATOR__OPENROUTER__TITLE=Switchboard NGX

# --- Frontend (Vite) ---
VITE_API_BASE=http://localhost:7080
#VITE_GITHUB_REDIRECT_PATH=/auth/callback
#VITE_DEFAULT_MODEL=openrouter/meta-llama/llama-3.1-70b-instruct
