// Switchboard API Contract (Crudder DSL)
//
// This schema defines all REST API endpoints and DTOs for the Switchboard application.
// It is used to generate both Rust backend code and TypeScript frontend code.

// =============================================================================
// COMMON TYPES
// =============================================================================

@module("common")
dto Empty {}

@module("common")
dto PaginationQuery {
    limit: int?
    offset: int?
}

@module("common")
@ts_module("common")
dto ErrorResponse {
    error: string
    message: string
}

// =============================================================================
// HEALTH
// =============================================================================

// Note: Field is named "time" to avoid crudder keyword conflict.
// The impl should use serde(rename = "timestamp") if API compatibility is needed.
@module("health")
@ts_module("health")
dto HealthResponse {
    status: string
    time: string
}

// =============================================================================
// AUTHENTICATION
// =============================================================================

@module("auth")
@ts_module("auth")
dto UserResponse {
    id: string
    email: string?
    display_name: string?
    avatar_url: string?
}

@module("auth")
@ts_module("auth")
dto SessionResponse {
    token: string
    user: UserResponse
    expires_at: string
}

@module("auth")
@ts_module("auth")
dto GithubLoginResponse {
    authorize_url: string
}

@module("auth")
@ts_module("auth")
dto GithubLoginQuery {
    redirect_uri: string
}

@module("auth")
@ts_module("auth")
dto GithubCallbackRequest {
    code: string
    state: string
    redirect_uri: string
}

// =============================================================================
// FOLDERS
// =============================================================================

@module("folder")
@ts_module("folders")
@table("folders")
dto Folder {
    @primary @auto
    id: int

    public_id: cuid2
    user_id: int
    name: string
    color: string?
    parent_id: int?
    collapsed: bool
    created_at: string
    updated_at: string
}

@module("folder")
@ts_module("folders")
dto FoldersResponse {
    folders: []Folder
}

@module("folder")
@ts_module("folders")
dto FolderResponse {
    folder: Folder
}

@module("folder")
@ts_module("folders")
dto CreateFolderRequest {
    name: string
    color: string?
    parent_id: cuid2?
}

@module("folder")
@ts_module("folders")
dto UpdateFolderRequest {
    name: string?
    color: string?
    collapsed: bool?
    parent_id: cuid2?
}

// =============================================================================
// CHATS
// =============================================================================

@module("chat")
@ts_module("chats")
dto ChatMemberResponse {
    id: string
    user_id: string
    role: string
    joined_at: string
    display_name: string?
    avatar_url: string?
}

@module("chat")
@ts_module("chats")
dto ChatResponse {
    id: int
    public_id: string
    user_id: int
    title: string
    description: string?
    avatar_url: string?
    folder_id: string?
    is_group: bool
    messages: string?
    created_by: string
    created_at: string
    updated_at: string
    member_count: int
    message_count: int
    last_message_at: string?
    members: []ChatMemberResponse
}

@module("chat")
@ts_module("chats")
dto ChatsResponse {
    chats: []ChatResponse
}

@module("chat")
@ts_module("chats")
dto CreateChatRequest {
    title: string
    description: string?
    avatar_url: string?
    folder_id: string?
    is_group: bool
    initial_message: string?
}

@module("chat")
@ts_module("chats")
dto UpdateChatRequest {
    title: string?
    description: string?
    avatar_url: string?
    folder_id: string?
}

@module("chat")
@ts_module("chats")
dto ListChatsQuery {
    folder_id: string?
    limit: int?
    offset: int?
}

// =============================================================================
// MESSAGES
// =============================================================================

@module("message")
@ts_module("messages")
dto MessageAttachmentResponse {
    id: string
    message_id: string
    file_name: string
    file_type: string
    file_size: int
    file_url: string
    created_at: string
}

@module("message")
@ts_module("messages")
dto MessageSenderResponse {
    id: string
    display_name: string?
    avatar_url: string?
}

@module("message")
@ts_module("messages")
dto MessageResponse {
    id: string
    chat_id: string
    sender_id: string
    content: string?
    message_type: string
    reply_to: string?
    thread_id: string?
    created_at: string
    updated_at: string?
    edited: bool
    deleted: bool
    sender: MessageSenderResponse
    attachments: []MessageAttachmentResponse
}

@module("message")
@ts_module("messages")
dto MessagesResponse {
    messages: []MessageResponse
}

@module("message")
@ts_module("messages")
dto CreateMessageRequest {
    content: string?
    message_type: string?
    reply_to: string?
    thread_id: string?
}

@module("message")
@ts_module("messages")
dto UpdateMessageRequest {
    content: string?
}

@module("message")
@ts_module("messages")
dto ListMessagesQuery {
    limit: int?
    offset: int?
    before: string?
    after: string?
    thread_id: string?
}

