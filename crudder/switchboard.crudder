@module("attachment")
@ts_module("attachments")
dto AttachmentResponse {
    id: string
    message_id: string
    chat_id: string
    file_name: string
    file_type: string
    file_size: int
    file_url: string
    created_at: string
    uploader: AttachmentUploaderResponse
}

@module("attachment")
@ts_module("attachments")
dto AttachmentsResponse {
    attachments: []AttachmentResponse
}

@module("attachment")
@ts_module("attachments")
dto CreateAttachmentRequest {
    file_name: string
    file_type: string
    file_size: int
    file_data: string
}

@module("attachment")
@ts_module("attachments")
dto ListAttachmentsQuery {
