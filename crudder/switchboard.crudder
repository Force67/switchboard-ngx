@module("member")
@ts_module("members")
dto MemberUserResponse {
    id: string
    display_name: string?
    avatar_url: string?
    email: string?
}

@module("member")
@ts_module("members")
dto MemberResponse {
    id: string
    user_id: string
    chat_id: string
    role: string
    joined_at: string
    user: MemberUserResponse
}

@module("member")
@ts_module("members")
dto MembersResponse {
    members: []MemberResponse
}

@module("member")
@ts_module("members")
dto UpdateMemberRoleRequest {
    role: string
}

@module("member")
@ts_module("members")
dto ListMembersQuery {
    role: string?
    limit: int?
    offset: int?
}

